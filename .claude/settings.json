{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git add *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git init *)",
      "Bash(git clone *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh api *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh workflow run *)",
      "Edit(.git/**)",
      "Edit(.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-repo-writes.sh\"",
            "statusMessage": "Checking for repo writes"
          }
        ]
      }
    ]
  }
}
