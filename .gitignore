# --- Secrets: never commit (AGENTS.md §5.2, architecture.md §8) ---
.env
.env.*
!.env.example
credentials/
# Service-account keys are .json files with unpredictable names, so all JSON is
# ignored. Allow-list a specific file with "!path/to/file.json" only if it is
# definitely not a credential.
*.json
!.claude/settings.json
# Baseline metadata written by `thwake baseline` (no secrets).
!data/baseline/aev_curve_v1.json
!data/baseline/landcover_flood_zone.json
!data/baseline/before_composite.json

# --- Large rasters: never commit (AGENTS.md §5.3) ---
*.tif
*.tiff

